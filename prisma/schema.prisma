// Coach Education — a Canvas-style platform for association football coaching.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One account can only ever be one of these. ADMIN spans both products: it is
/// the coach-education program admin and the FQ Club Development Unit.
///
/// SQLite stores enums as plain TEXT, so adding CLUB and ASSESSOR needs no
/// column change — only the generated client's validation moves.
enum Role {
  ADMIN
  COACH

  /// Coach education's own assessor — FQ calls them the Coach Education Team.
  ///
  /// Marks the register, rates practical deliveries, grades coursework and runs
  /// post-course support, on the courses they are rostered onto and no others.
  /// Cannot create, publish or delete a course, cannot author coursework,
  /// cannot manage accounts, and has no business in the club development
  /// portal at all.
  ///
  /// Deliberately not called ASSESSOR: that word is taken, by somebody who
  /// assesses clubs rather than coaches. Two products, two jobs, two names.
  EDUCATOR

  /// CDA: a club's designated administrator. Sees only their own club.
  CLUB

  /// CDA: an FQ assessor. Sees only the clubs they are assigned to.
  ASSESSOR
}

/// Small things the app has to remember between boots.
///
/// Currently one row: a fingerprint of the rubric catalogue shipped in the
/// running image. The catalogue sync runs on every container start, and on a
/// hosted database each of its ~160 upserts is a network round trip — several
/// seconds spent, on every wake, to discover nothing has changed. Comparing one
/// hash first turns that into a single query.
model Meta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  title     String? // e.g. "U15 Girls Head Coach"
  role      Role     @default(COACH)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  /// Whether a Club Development Unit account also scores line items.
  ///
  /// An account holds one role, and for everything else that is right. But the
  /// Unit is small enough that the people who administer the cycle are also
  /// among the people who assess it, and forcing that person to hold two
  /// accounts under two addresses buys nothing: it splits one human's work
  /// across two identities, which is worse for the audit trail, not better.
  ///
  /// Off by default and only meaningful on an ADMIN. It grants no extra
  /// authority — an ADMIN can already read every assessment — it only makes
  /// them allocatable to a line item. The overlap it creates is recorded
  /// rather than prevented: see the assessment's audit trail, which flags a
  /// line item whose reconciled score was settled by one of its own assessors.
  assesses Boolean @default(false)

  /// Whether this account is in the Club Development Unit.
  ///
  /// Its own grant rather than a consequence of being an ADMIN. Promoting
  /// somebody to admin in Coach Education used to hand them every club's
  /// assessment, evidence and scores as a side effect — two products sharing an
  /// account system, and one role standing in for both. It is granted on
  /// purpose now, and the migration that introduced it gave it to every admin
  /// who already had it so nobody lost access on the deploy.
  ///
  /// Only meaningful on an ADMIN: `requireCdu` checks both.
  cdu Boolean @default(false)

  /// A head-and-shoulders photo, so an educator on the grass knows who is who.
  ///
  /// On the account rather than the enrolment: the point of it is recognising
  /// the same coach across courses and years, and a photo per intake would
  /// mean taking it again every time. One current photo, replaced rather than
  /// accumulated — this is a name badge, not an album.
  ///
  /// Readable by coach-education staff and by the coach themselves, and by
  /// nobody else; see `canAccessUpload`.
  photoId String? @unique
  photo   Upload? @relation("CoachPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  sessions     Session[]
  loginTokens  LoginToken[]
  enrollments  Enrollment[]
  submissions  Submission[]
  quizAttempts QuizAttempt[]

  gradedSubmissions Submission[]  @relation("SubmissionGrader")
  gradedAttempts    QuizAttempt[] @relation("AttemptGrader")
  authoredCourses   Course[]      @relation("CourseAuthor")

  // Course delivery. An educator is rostered onto a course as CET, and named
  // on every practical delivery they assessed.
  courseStaffRoles   CourseStaff[]       @relation("CourseStaffUser")
  assessedDeliveries PracticalDelivery[] @relation("DeliveryAssessor")
  openedMakeUps      AttendanceMakeUp[]  @relation("MakeUpOpener")

  // Post-course support. A coach holds cases; an educator is named on the ones
  // they run and on every attempt they have written up.
  supportCases     SupportCase[]    @relation("SupportCoach")
  supportCaseload  SupportCase[]    @relation("SupportEducator")
  supportReferrals SupportCase[]    @relation("SupportReferrer")
  supportReviews   SupportAttempt[] @relation("SupportReviewer")

  // Club Development & Assessment
  clubMemberships        ClubMembership[]
  ambassadorFor          ClubAmbassador[]      @relation("ClubAmbassadors")
  criterionAssignments   CriterionAssignment[] @relation("CriterionAssignments")
  assessorScores         AssessorScore[]       @relation("AssessorScores")
  resolvedScores         FinalScore[]          @relation("ScoreResolver")
  lockedAssessments      ClubAssessment[]      @relation("AssessmentLocker")
  verifiedNonNegotiables NonNegotiableResult[] @relation("NonNegotiableVerifier")
  areaNotes              AreaNote[]            @relation("AreaNoteAuthor")
  reviewsSubmitted       ReviewRequest[]       @relation("ReviewSubmitter")
  reviewsAnswered        ReviewRequest[]       @relation("ReviewResponder")
  appealsDecided         ReviewRequest[]       @relation("AppealDecider")

  @@index([role])
}

/// One-time, single-use magic-link tokens. Only the hash is stored.
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Browser session, keyed by an httpOnly cookie. Only the hash is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  season      String? // e.g. "2026 Pre-Season"
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  authorId    String?
  author      User?    @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// The FQ rating a coach has to reach to pass, on the 1-5 scale in
  /// src/lib/support-rubric.ts. 2.5 on every AFC/FA diploma.
  ///
  /// Null means the course isn't rated: it is complete-it-and-you're-done, and
  /// nobody can fail it. Where a threshold is set, a coach rated below it has
  /// not passed, and the rubric's own name for what happens next is
  /// post-course support.
  ratingThreshold Float?

  /// What the course is an accreditation in — "B Diploma", "C Licence".
  qualification String?
  /// The register's course name: "Metro", "Regional".
  stream        String?
  /// Where it is delivered, and the ground.
  location      String?
  venue         String?

  enrollments  Enrollment[]
  materials    Material[]
  assignments  Assignment[]
  quizzes      Quiz[]
  supportCases SupportCase[]
  days         CourseDay[]
  staff        CourseStaff[]
}

/// An enrolment, and the row the coach occupies on the course's register.
///
/// Everything below the relations comes off Football Queensland's attendance
/// register: the roster block on the left, the result block on the right. It
/// hangs here rather than on User because all of it is as-at-this-course — a
/// coach's age, club and age group are true of the intake they sat, and a coach
/// who returns two years later is a second row, not an edit to the first.
model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// The register's # column, so a roster reads back in the order it was kept.
  position Int             @default(0)
  track    EnrollmentTrack @default(MAIN)

  /// What a catch-up is catching up: "Day 6 & Block 3".
  ///
  /// The register keeps this in the Club column of its catch-ups block, which
  /// is why a catch-up never carries a club — the column is doing another job.
  catchUpNote String?

  // The roster block.
  ageAtCourse      Int?
  gender           String?
  clubName         String?
  coachingAgeGroup String?

  /// FALC's enrolment state — "Enrolled", "Initiated Enrolment".
  enrolmentStatus String?

  // ---- The window on the course ------------------------------------------
  //
  // Not everybody does all nine days of the course they are listed on. Coaches
  // join at Block 2 and pick up Block 1 elsewhere; coaches do Block 1 here and
  // move to another intake. Without a window, both look like somebody who
  // simply didn't turn up, and the register puts them twenty-four hours short
  // of a standard nobody was holding them to.
  //
  // Null at both ends is the ordinary case: the coach is on the course for all
  // of it.

  /// The first day this coach was on this course, if not the first day of it.
  joinedAt DateTime?

  /// The last day they were on it, if they didn't see it out.
  leftAt DateTime?

  /// The enrolment that continues this one when a coach moves courses.
  ///
  /// A one-to-one link rather than a status, so "transferred" can never be
  /// recorded without saying where to — which is the only fact that makes the
  /// hours findable afterwards.
  transferredToId String?     @unique
  transferredTo   Enrollment? @relation("EnrollmentTransfer", fields: [transferredToId], references: [id], onDelete: SetNull)
  transferredFrom Enrollment? @relation("EnrollmentTransfer")

  /// Why they moved, in the educator's words.
  transferNote String?
  /// FALC's identifier for this coach, so a re-import matches on more than a name.
  externalRef  String?

  // The result block.
  /// Whether the coach met the course's attendance requirement.
  attendanceMet    Boolean?
  journalComplete  Boolean?
  /// FQ rating, 1-5 in half steps. Null until somebody rates them.
  rating           Float?
  outcome          CourseOutcome @default(IN_PROGRESS)
  /// How ready they are for the next licence: "Now", "1-3 Years", "Never".
  readiness        String?
  /// The register's own Comments column, kept as written.
  registerComments String?

  attendance Attendance[]
  deliveries PracticalDelivery[]
  makeUps    AttendanceMakeUp[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([outcome])
}

enum MaterialKind {
  FILE
  VIDEO
  LINK
}

/// Course library: session plans, resources, and video.
model Material {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  kind        MaterialKind @default(FILE)
  /// External URL for LINK/VIDEO materials.
  url         String?
  /// Stored upload for FILE materials.
  uploadId    String?      @unique
  upload      Upload?      @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([courseId])
}

/// An uploaded file. Served only through an authorization-checking route.
///
/// Contents live in the row rather than on disk so the app runs on hosts with
/// no persistent filesystem. Large media belongs in a VIDEO/LINK material
/// pointing at YouTube or Vimeo instead.
model Upload {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  material         Material?
  submissionFileOf Submission? @relation("SubmissionUploads", fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId     String?

  // CDA evidence. A club attaches qualification certificates to a staff member
  // and supporting documents to a Non-Negotiable declaration; both are read
  // back through the same authorization-checking download route.
  staffCertificateOf    StaffMember?         @relation("StaffCertificates", fields: [staffMemberId], references: [id], onDelete: Cascade)
  staffMemberId         String?
  nonNegotiableProofOf  NonNegotiableResult? @relation("NonNegotiableEvidence", fields: [nonNegotiableResultId], references: [id], onDelete: Cascade)
  nonNegotiableResultId String?

  // Post-course support: the session plan and any supporting paperwork a coach
  // attaches to a delivery they are being reassessed on. The footage itself is
  // a link, never an upload.
  supportAttemptOf SupportAttempt? @relation("SupportAttemptFiles", fields: [supportAttemptId], references: [id], onDelete: Cascade)
  supportAttemptId String?

  // A coach's photo. The back half of the one-to-one on User.photoId.
  photoOf User? @relation("CoachPhoto")

  @@index([submissionId])
  @@index([staffMemberId])
  @@index([nonNegotiableResultId])
  @@index([supportAttemptId])
}

model Assignment {
  id           String    @id @default(cuid())
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  points       Int       @default(100)
  dueAt        DateTime?
  allowText    Boolean   @default(true)
  allowFiles   Boolean   @default(true)
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())

  submissions Submission[]

  @@index([courseId])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String?
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  score      Float?
  feedback   String?
  gradedAt   DateTime?
  gradedById String?
  gradedBy   User?     @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  files Upload[] @relation("SubmissionUploads")

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([status])
}

model Quiz {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime?
  /// null = unlimited retakes
  maxAttempts Int?      @default(1)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

enum QuestionKind {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Question {
  id        String       @id @default(cuid())
  quizId    String
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt    String
  kind      QuestionKind @default(MULTIPLE_CHOICE)
  points    Int          @default(1)
  position  Int          @default(0)
  /// Shown after grading, regardless of correctness.
  rationale String?

  choices Choice[]
  answers Answer[]

  @@index([quizId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int      @default(0)

  answers Answer[]

  @@index([questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  /// Auto-graded, but contains short answers a coach still has to read.
  AWAITING_REVIEW
  GRADED
}

model QuizAttempt {
  id          String        @id @default(cuid())
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  attemptNo   Int           @default(1)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?

  score      Float?
  maxScore   Float?
  feedback   String?
  gradedAt   DateTime?
  gradedById String?
  gradedBy   User?     @relation("AttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  answers Answer[]

  @@unique([quizId, userId, attemptNo])
  @@index([userId])
  @@index([status])
}

model Answer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceId   String?
  choice     Choice?     @relation(fields: [choiceId], references: [id], onDelete: SetNull)
  text       String?

  /// null while a short answer is awaiting human review
  isCorrect     Boolean?
  pointsAwarded Float?
  graderComment String?

  @@unique([attemptId, questionId])
  @@index([questionId])
}

/**
 * ==========================================================================
 * The attendance register
 * --------------------------------------------------------------------------
 * Football Queensland runs its AFC/FA diplomas off one spreadsheet per course:
 * nine delivery days across three blocks, a roster, a catch-ups block for
 * coaches making up time on another course, the CET team's own attendance, and
 * a grid of Yes/No between them. Beside it sits an assessment sheet holding
 * each coach's practical deliveries, and a rating out of five.
 * These tables are that register. Shape of the data:
 * Course ──< CourseDay  ──< Attendance      >── Enrollment
 * ──< CourseStaff ──< StaffAttendance
 * Enrollment ──< PracticalDelivery
 * The register is the source of truth for whether a coach passed, and it does
 * not work in percentages: a coach is rated 1-5 against the rubric in
 * src/lib/support-rubric.ts, and anything below the course's threshold is the
 * rubric's own "post-course support".
 * ==========================================================================
 */

/// Which block of the register a coach's row sits in.
enum EnrollmentTrack {
  /// The roster proper.
  MAIN

  /// Catching up hours missed, or deferred in from an earlier intake. They
  /// attend the same days and are assessed the same way; they are tracked
  /// separately because the register does, and because their attendance is
  /// partial by definition and would drag a course's totals down.
  CATCH_UP
}

/// The register's Outcome column.
enum CourseOutcome {
  IN_PROGRESS

  /// "Pass on course" — rated at or above the course's threshold.
  PASSED

  /// Rated below the threshold. Not a fail: the rubric's own next step, and
  /// what opens a SupportCase.
  POST_COURSE_SUPPORT

  /// Left the course. Distinct from being rated short of the standard.
  WITHDRAWN

  /// Moved to another course. Distinct from withdrawing: the coach is still
  /// on the pathway, and their enrolment continues elsewhere — see
  /// `Enrollment.transferredTo`.
  TRANSFERRED
}

/// One delivery day of a course.
model CourseDay {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  dayNo   Int
  /// As the register writes it. Kept rather than derived from the date: a day
  /// that moves is often corrected in one column and not the other, and the
  /// register is the record of what was actually run.
  weekday String?
  date    DateTime

  /// Wall-clock labels — "08:30", "16:30" — not instants.
  ///
  /// A course day starts at half past eight where it is being held, and storing
  /// that as a timestamp would make it depend on the server's zone. Queensland
  /// keeps no daylight saving, so this never needs arithmetic anyway.
  startTime String?
  endTime   String?

  attendance      Attendance[]
  staffAttendance StaffAttendance[]
  makeUps         AttendanceMakeUp[]

  @@unique([courseId, dayNo])
  @@index([courseId])
}

/// How long one coach was there on one day.
///
/// A missing row means nobody marked it, which is not the same as absent: on a
/// course still in its first block, days 4 to 9 are unmarked for everybody.
model Attendance {
  id           String     @id @default(cuid())
  courseDayId  String
  courseDay    CourseDay  @relation(fields: [courseDayId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// Minutes actually attended. Zero is absent; the day's scheduled length is
  /// present; anything between is what happened.
  ///
  /// Minutes rather than a yes/no, because the registers are full of half days
  /// — "Missed Day 2 PM", "3 hours missed on Day 2", "1.5 hours Day 3". A
  /// boolean rounds each of those to a whole day in one direction or the other,
  /// and the register works around it in the Comments column, where nothing can
  /// add it up.
  minutes Int

  /// The debts these hours paid off. Usually empty; set when a coach sat a day
  /// on one course to make up time owed on another.
  credits AttendanceMakeUp[] @relation("MakeUpCredit")

  @@unique([courseDayId, enrollmentId])
  @@index([enrollmentId])
}

/// A member of the course team — CET1 to CET5, and course experience support.
model CourseStaff {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// The register's own label for the seat: "CET1", "CX Support".
  role String
  name String

  /// The account behind the name, where there is one.
  ///
  /// Nullable because a register names people before they have an account here,
  /// and a course team that only half exists in this system is still worth
  /// recording — the roster is what an educator checks, not the join.
  userId String?
  user   User?   @relation("CourseStaffUser", fields: [userId], references: [id], onDelete: SetNull)

  position   Int               @default(0)
  attendance StaffAttendance[]

  @@unique([courseId, role])
  @@index([courseId])
  @@index([userId])
}

model StaffAttendance {
  id          String      @id @default(cuid())
  courseDayId String
  courseDay   CourseDay   @relation(fields: [courseDayId], references: [id], onDelete: Cascade)
  staffId     String
  staff       CourseStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  present     Boolean

  @@unique([courseDayId, staffId])
  @@index([staffId])
}

/// One assessed practical delivery — the coach in front of a group, watched.
///
/// The register keeps this as a small form typed into one spreadsheet cell.
/// The parsed fields are what the app reads; `raw` is the cell as it was
/// written, because the form is free text and a parser that gets it wrong
/// should lose formatting, never content.
model PracticalDelivery {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  deliveryNo   Int

  /// The educator who watched it, as the register names them.
  assessor     String?
  /// Their account, where the name resolved to one.
  assessorId   String?
  assessorUser User?   @relation("DeliveryAssessor", fields: [assessorId], references: [id], onDelete: SetNull)

  /// Which block of the course it happened in.
  block     String?
  /// "Play" or "Practice" — which half of the session was assessed.
  component String?
  topic     String?

  comment    String?
  actionPlan String?
  /// The session's own rating, 1-5. The coach's course rating is a judgement
  /// across all of them, not an average of them.
  rating     Float?

  raw       String?
  createdAt DateTime @default(now())

  @@unique([enrollmentId, deliveryNo])
  @@index([enrollmentId])
  @@index([assessorId])
}

/// Whether a debt has been settled, and how far along it is.
enum MakeUpStatus {
  /// Recorded, with nothing arranged yet.
  OWED

  /// A day has been found for it — often on another club's course.
  ARRANGED

  /// Fully covered.
  COMPLETED

  /// Written off. Force majeure, a course that has ended, an educator's call.
  WAIVED
}

/// Time a coach owes on their own course, and what covered it.
///
/// The registers coordinate this in prose — "Needs to catch up full day of Day
/// 3 on Sunny Coast B", "Send tasks to make up 3 hours missed on Day 2", "Make
/// up Toowoomba Day 1 (Missed Day 2 PM)" — spread across the Comments column of
/// three separate spreadsheets. That works while one person holds all three in
/// their head, and it cannot answer "who still owes hours?".
///
/// A debt is opened against the enrolment that is short and closed by pointing
/// at the attendance that covered it. That attendance usually sits on a
/// different course, which is the whole point: the credit and the debt live on
/// different registers, and this row is the only thing that knows they are the
/// same hours.
model AttendanceMakeUp {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// The day missed, when it was a particular one. Null covers the register's
  /// looser debts — "a few hours on another B", "Block 3".
  courseDayId String?
  courseDay   CourseDay? @relation(fields: [courseDayId], references: [id], onDelete: SetNull)

  minutesOwed     Int
  minutesCredited Int          @default(0)
  status          MakeUpStatus @default(OWED)

  /// The attendance that paid it off, when the hours were sat on a course this
  /// system holds.
  creditedAttendanceId String?
  creditedAttendance   Attendance? @relation("MakeUpCredit", fields: [creditedAttendanceId], references: [id], onDelete: SetNull)

  /// How it was made up when there is no attendance row to point at: written
  /// tasks, a webinar, a course FQ runs that this system doesn't hold.
  creditedNote String?

  /// What has been agreed but not yet done — "GCK Day 3 or Sunny Coast Day 3".
  arrangedNote String?

  openedAt   DateTime  @default(now())
  settledAt  DateTime?
  openedById String?
  openedBy   User?     @relation("MakeUpOpener", fields: [openedById], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([status])
  @@index([creditedAttendanceId])
}

/**
 * ==========================================================================
 * Post-course support
 * --------------------------------------------------------------------------
 * Coursework tells you whether a coach knows the material. It does not tell
 * you whether they can run a session, and a coach who finishes a course below
 * its pass mark has not been shown to be unable to coach — only that the
 * written work did not demonstrate it.
 * So finishing below the mark opens a support case rather than closing the
 * course. The coach is reassessed on an actual session delivery, by one of two
 * routes:
 * LIVE_ASSESSMENT — an educator attends a session and observes it.
 * VIDEO_REVIEW    — the coach films a session and submits the link.
 * Both end in the same place: an educator rates the delivery against one
 * rubric and records an outcome. The route is a matter of geography and
 * diaries, not of standard — a coach five hours from Brisbane submits film,
 * and is held to exactly what a coach observed in person is held to.
 * Shape of the data:
 * SupportCase ──< SupportAttempt ──< SupportRating
 * A case is one coach's route back on one course. Each attempt is one
 * observation or one piece of film, carrying its own pathway — a coach whose
 * first attempt was filmed can be observed live the second time without
 * anything being rewritten. Ratings are the reviewer's marks against the
 * rubric in src/lib/support.ts, one row per criterion.
 * ==========================================================================
 */

enum SupportPathway {
  /// An educator attends a session and observes it in person.
  LIVE_ASSESSMENT

  /// The coach films a session they deliver and submits the link.
  VIDEO_REVIEW
}

enum SupportCaseStatus {
  /// Referred, and still working through it.
  IN_PROGRESS

  /// A delivery was assessed as successful. The course is passed.
  SUCCESSFUL

  /// Closed without success — attempts used up, or the CDU called it.
  UNSUCCESSFUL

  /// Closed without an outcome: the coach left the program, moved clubs, or
  /// was referred in error. Distinct from UNSUCCESSFUL, which is a judgement.
  WITHDRAWN
}

enum SupportAttemptStatus {
  /// Live pathway: a date and venue are set and the educator is expected.
  SCHEDULED

  /// Video pathway: waiting on the coach to submit their footage.
  AWAITING_VIDEO

  /// Waiting on the educator — film is in, or the observation has happened.
  SUBMITTED

  /// Rated and decided.
  REVIEWED
}

enum SupportOutcome {
  SUCCESSFUL

  /// Not a fail. The delivery didn't yet demonstrate the standard, and the
  /// case stays open for another attempt if the coach has one left.
  NOT_YET_SUCCESSFUL
}

/// One coach's route back onto one course.
model SupportCase {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("SupportCoach", fields: [userId], references: [id], onDelete: Cascade)

  status SupportCaseStatus @default(IN_PROGRESS)

  /// Why the coach was referred, in the referrer's words. Shown to the coach:
  /// being told you need support without being told what for is the thing this
  /// process exists to avoid.
  reason String?

  /// The coach's course rating at the moment of referral, frozen.
  ///
  /// An educator can revise a rating after a referral, and a late practical
  /// delivery can move it. Neither should quietly rewrite the reason a case was
  /// opened, so the figure that triggered it is kept as it stood.
  referredRating Float?

  /// How many deliveries the coach may be assessed on. FQ's default is two —
  /// the reassessment, and one further opportunity — but an educator can raise
  /// it on a case where circumstances warrant it.
  attemptsAllowed Int @default(2)

  /// The educator running the case. Any admin can act on any case; this is who
  /// is expected to, and it is what the coach sees as their contact.
  educatorId String?
  educator   User?   @relation("SupportEducator", fields: [educatorId], references: [id], onDelete: SetNull)

  referredById String?
  referredBy   User?   @relation("SupportReferrer", fields: [referredById], references: [id], onDelete: SetNull)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  /// The educator's closing note, written when the case ends either way.
  closingNote String?

  attempts SupportAttempt[]

  /// One case per coach per course. A course here is already a single season's
  /// offering, so a second run of the same course is a second course row.
  @@unique([courseId, userId])
  @@index([status])
  @@index([userId])
  @@index([educatorId])
}

/// One observation or one piece of film, and the review of it.
model SupportAttempt {
  id        String      @id @default(cuid())
  caseId    String
  case      SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attemptNo Int         @default(1)

  pathway SupportPathway
  status  SupportAttemptStatus

  /// When the delivery is expected: the observation slot on the live pathway,
  /// the date footage is due on the video pathway.
  dueAt DateTime?

  /// Live pathway only — where the educator is going.
  venue String?

  /// Video pathway only. A link to YouTube or Vimeo, never an upload: session
  /// footage is hundreds of megabytes and this app keeps its files in the
  /// database.
  videoUrl String?

  /// What the coach wants the reviewer to know — the age group, the theme, the
  /// numbers they had on the night.
  coachNotes String?

  submittedAt DateTime?

  outcome      SupportOutcome?
  /// The delivery's overall FQ rating, 1-5.
  ///
  /// Computed from the criterion marks on save and never read from the form,
  /// the same way a CDA star band is. What the reviewer chooses is the
  /// outcome; the rubric decides which outcomes that rating leaves open.
  rating       Float?
  /// The reviewer's written feedback to the coach.
  feedback     String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?           @relation("SupportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  ratings SupportRating[]
  /// The session plan and any supporting paperwork.
  files   Upload[]        @relation("SupportAttemptFiles")

  @@unique([caseId, attemptNo])
  @@index([status])
  @@index([caseId])
}

/// A reviewer's mark against one criterion of the delivery rubric.
///
/// The criterion is referenced by code rather than by foreign key: unlike the
/// CDA rubric, which the Unit rewords between cycles, this one is Football
/// Australia's and is not FQ's to reword mid-intake. Storing the code keeps a
/// completed review readable even if a criterion is retired later.
model SupportRating {
  id        String         @id @default(cuid())
  attemptId String
  attempt   SupportAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  /// Matches a `code` in SUPPORT_CRITERIA (src/lib/support-rubric.ts).
  code    String
  /// 1-5 in half steps, per Football Australia's rubric.
  rating  Float
  comment String?

  @@unique([attemptId, code])
  @@index([attemptId])
}

/**
 * ==========================================================================
 * Club Development & Assessment (CDA) Portal
 * --------------------------------------------------------------------------
 * Football Queensland rates each affiliated club once a year across four
 * domains — Technical Qualifications, Planning, Delivery and Outcomes — and
 * awards a shield (Bronze/Silver/Gold/Platinum) from the weighted total.
 * Nine Non-Negotiables gate the award entirely: fail one and no shield is
 * possible regardless of score.
 * Shape of the data:
 * Club  ──<  ClubAssessment  >── Cycle          one row per club, per year
 * ClubAssessment ──< StaffMember                Technical Qualifications
 * ClubAssessment ──< AssessorScore >── Criterion  up to 3 independent scores
 * ClubAssessment ──< FinalScore    >── Criterion  one reconciled score
 * ClubAssessment ──< NonNegotiableResult
 * Criteria live in their own catalogue rather than in code so the CDU can
 * reword a criterion or retire one between cycles without a deploy.
 * ==========================================================================
 */

/// An affiliated club. Long-lived: it carries across cycles, and its rating
/// history is the sequence of ClubAssessments hanging off it.
model Club {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  /// FQ zone, e.g. "Brisbane Metro", "Far North Queensland".
  zone         String?
  /// Competition tier the senior team plays in, e.g. "NPL", "FQPL", "Community".
  tier         String?
  contactName  String?
  contactEmail String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// Which set of line items this club is normally assessed on.
  ///
  /// On the club rather than only on the assessment because it is a standing
  /// fact about the club — a Tier 2 club is Tier 2 next season too — and because
  /// clubs are often loaded before a cycle exists. Without it, a tier recorded
  /// at import had nowhere to live until an assessment was opened and was
  /// silently discarded. Each assessment still carries its own tier, so moving a
  /// club between tiers never rewrites a season already scored.
  tierId      String?
  defaultTier Tier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)

  members     ClubMembership[]
  assessments ClubAssessment[]
  ambassadors ClubAmbassador[]

  @@index([zone])
  @@index([tierId])
}

/// The clubs a Club Development Ambassador looks after through the year.
///
/// Standing, and independent of any cycle: a CDA visits and supports these
/// clubs whether or not a rating is running, so this outlives the pool and the
/// line-item allocation that decide who scores what in a given season.
///
/// It is also the visibility boundary. An assessor reaches a club only where
/// their portfolio and their allocation overlap — holding a line item across a
/// pool no longer opens every club in it. Kept as its own table rather than a
/// column on Club because a club can have more than one CDA, and because a CDA
/// leaving takes their portfolio with them without touching the clubs.
model ClubAmbassador {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ClubAmbassadors", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([userId])
}

/// Grants a CLUB user access to one club. Modelled as a join rather than a
/// column on User so a club can have more than one administrator, and so a
/// handover doesn't mean editing the account that is signed in.
model ClubMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clubId])
  @@index([clubId])
}

enum CycleStatus {
  /// Criteria and weights being configured; nothing visible to clubs yet.
  SETUP
  /// Clubs entering staff, metrics and Non-Negotiable declarations.
  CLUB_ENTRY
  /// Assessors scoring.
  ASSESSING
  /// CDU resolving disagreements and locking scores.
  RECONCILING
  /// Ratings released to clubs.
  PUBLISHED
}

/// One assessment year.
///
/// Weights and shield thresholds are stored per cycle, not globally, so that
/// re-tuning next year's rubric can never change what a club was awarded in a
/// year already published.
model Cycle {
  id        String      @id @default(cuid())
  year      Int         @unique
  name      String
  status    CycleStatus @default(SETUP)
  opensAt   DateTime?
  closesAt  DateTime?
  createdAt DateTime    @default(now())

  /// Points available for Technical Qualifications.
  ///
  /// The other three domains get their maximum from their own line items — sum
  /// of maxScore x weighting — so their share of the rating emerges from the
  /// catalogue rather than being set. Technical has no line items, so its
  /// maximum is stated here, which is also how FQ does it: their Technical
  /// maximum comes from a table of team profiles, not from the criteria.
  ///
  /// Changing this moves Technical's share of the total, and therefore
  /// everything else's. It is per-cycle so that a published year keeps the
  /// balance it was actually judged under. A tier may override it.
  ///
  /// 330 is Football Queensland's own figure for a Tier 1 club on their 2026
  /// CASE 2 team profile.
  technicalMaxPoints Int @default(330)

  /// Minimum weighted-total percentage for each shield. Football Queensland's
  /// own figures: Gold at 75%, Silver at 55%, Bronze at 40%. Per-cycle because
  /// FQ restates them each year, and a published year has to keep the bar it
  /// was actually judged against.
  bronzeMin Int @default(40)
  silverMin Int @default(55)
  goldMin   Int @default(75)

  /// Tier 2's own bar. "Development Committed rating is awarded if minimum 55%
  /// is achieved out of the overall maximum points."
  ///
  /// Its own column rather than a reuse of silverMin, which it happens to equal
  /// in 2026: FQ raises Silver to 60% in 2027 and says nothing about moving
  /// this, and a Tier 2 club should not be dragged up by a Tier 1 change.
  developmentMin Int @default(55)

  assessments ClubAssessment[]
  pools       Pool[]

  structureStandards StructureStandard[]
}

enum AssessmentStatus {
  /// Created, club hasn't opened it.
  NOT_STARTED
  /// Club is filling in staff, metrics and Non-Negotiables.
  IN_PROGRESS
  /// Club has declared their data complete; assessors can score.
  SUBMITTED
  /// At least one assessor has started.
  IN_ASSESSMENT
  /// All assigned assessors have submitted; CDU reconciling.
  RECONCILING
  /// Scores locked. Result computed and frozen, not yet visible to the club.
  LOCKED
  /// The *preliminary* rating has been released to the club. FQ's word, and it
  /// matters: a club may only publish its shield once the rating is Confirmed,
  /// so this is a result they can read and challenge but not yet display.
  PUBLISHED
  /// The club asked for specific line items to be re-examined, and the Unit
  /// has 10 working days to respond.
  IN_REVIEW
  /// The club appealed the review outcome to the CEO, who has 8 working days.
  UNDER_APPEAL
  /// Final. Either the review window lapsed with no request, or the review and
  /// any appeal are exhausted. This is the rating the club may publish.
  CONFIRMED
}

/// Football Queensland awards three shields. Gold is the top — there is no
/// Platinum, and inventing one would have the portal promising clubs a level
/// FQ does not issue a shield for.
///
/// Declared weakest to strongest: the threshold Non-Negotiables cap a club at
/// the level it met, and that comparison reads this order.
enum Shield {
  /// Below the Bronze threshold, and not eligible for the Development
  /// Committed badge either.
  NONE
  /// Not a shield. FQ's own words: "All clubs scoring less than 40% of the
  /// overall points will receive an FQ Development Committed badge for their FQ
  /// Academy assessment if they are licence compliant (in non-technical
  /// areas)." It sits in this enum because it is what the club is awarded at
  /// that band, and it has to compare below Bronze.
  DEVELOPMENT_COMMITTED
  BRONZE
  SILVER
  GOLD
}

/// One club's assessment for one cycle. The hub of the whole model.
model ClubAssessment {
  id      String           @id @default(cuid())
  clubId  String
  club    Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  cycleId String
  cycle   Cycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  status  AssessmentStatus @default(NOT_STARTED)

  clubSubmittedAt DateTime?
  lockedAt        DateTime?
  lockedById      String?
  lockedBy        User?     @relation("AssessmentLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  publishedAt     DateTime?

  /// The result, frozen at lock time.
  ///
  /// Deliberately stored rather than recomputed on read: criteria get reworded,
  /// weights get re-tuned and staff records get corrected, and none of that may
  /// retroactively change a rating a club has already been told about. Before
  /// the lock these are null and every view computes live from the rubric.
  finalPercent Float?
  technicalPct Float?
  planningPct  Float?
  deliveryPct  Float?
  outcomesPct  Float?
  finalShield  Shield?
  /// False when a Non-Negotiable failed — no shield, whatever the score.
  eligible     Boolean?

  /// Whether the club is licence compliant in non-technical areas.
  ///
  /// The one condition FQ attaches to the Development Committed badge, and it
  /// is information the Unit holds rather than anything this assessment
  /// measures — compliance sits under the Advanced Participation Licence, not
  /// under the rating. Null means nobody has said, and that is treated as "no
  /// badge": a recognition FQ publishes should not be handed out by default.
  /// Only consulted below the Bronze threshold.
  licenceCompliant Boolean?
  /// CDU's summary paragraph on the published report.
  summary          String?

  /// Which pool this club is assessed in. Nullable because a club can be added
  /// to a cycle before the CDU has drawn the pools up.
  poolId String?
  pool   Pool?   @relation(fields: [poolId], references: [id], onDelete: SetNull)

  /// Which set of line items this club is assessed on. Null falls back to the
  /// first tier, so a club added before tiers are set up is still assessable.
  tierId String?
  tier   Tier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)

  staff          StaffMember[]
  scores         AssessorScore[]
  finalScores    FinalScore[]
  nonNegotiables NonNegotiableResult[]
  metrics        ClubMetric[]
  areaNotes      AreaNote[]
  review         ReviewRequest?
  structure      StructureEntry[]

  @@unique([clubId, cycleId])
  @@index([cycleId])
  @@index([status])
  @@index([poolId])
  @@index([tierId])
}

/// An assessment tier. Tier 2 clubs are assessed on a subset of the same line
/// items Tier 1 clubs are — same codes, same wording, fewer of them — so a
/// club's maximum points depend on its tier, and the tier has to be part of the
/// data rather than a label on the club.
model Tier {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  position Int    @default(0)

  /// Points available for Technical Qualifications at this tier, overriding the
  /// cycle's figure. A Tier 2 club fields fewer teams and is assessed on fewer
  /// line items, so holding Technical at the Tier 1 maximum would make it 44% of
  /// their rating instead of a quarter. FQ derives the real figure from a table
  /// of team profiles; this is the same idea, per tier.
  technicalMaxPoints Int?

  criteria    Criterion[]
  assessments ClubAssessment[]
  clubs       Club[]
}

/// A group of clubs assessed together within a cycle.
///
/// A pool is the unit an assessor is given: they take one criterion across
/// every club in one pool. Pools are per-cycle because clubs move between them
/// year to year.
model Pool {
  id       String @id @default(cuid())
  cycleId  String
  cycle    Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  /// "A", "B", "C".
  name     String
  position Int    @default(0)

  assessments ClubAssessment[]
  assignments CriterionAssignment[]

  @@unique([cycleId, name])
}

/// Assigns an assessor one criterion across every club in one pool.
///
/// This is Football Queensland's "vertical" assessment, and it is the whole
/// point: one person applies one criterion to twelve clubs in a sitting, which
/// is what makes the standard consistent between them. Assigning an assessor a
/// club and asking them to score forty different criteria produces the opposite
/// — forty standards, each applied once.
///
/// `slot` is 1, 2 or 3. Slots 1 and 2 assess independently; slot 3 exists only
/// to break a disagreement between them, so it is normally empty.
model CriterionAssignment {
  id          String    @id @default(cuid())
  poolId      String
  pool        Pool      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  assessorId  String
  assessor    User      @relation("CriterionAssignments", fields: [assessorId], references: [id], onDelete: Cascade)
  slot        Int       @default(1)
  createdAt   DateTime  @default(now())
  /// Set when the assessor declares this line item finished across the pool.
  submittedAt DateTime?

  /// One assessor per slot…
  @@unique([poolId, criterionId, slot])
  /// …and nobody assessing the same line item twice.
  @@unique([poolId, criterionId, assessorId])
  @@index([assessorId])
  @@index([criterionId])
}

/**
 * ------------------------------ Domain 1: Technical Qualifications --------
 */

enum QualificationStream {
  OUTFIELD
  GOALKEEPING
  /// Community/grassroots certificates, which count in any role but score low.
  COMMUNITY
}

/// The qualification ladder, AFC Pro Diploma down to grassroots certificates.
///
/// A table rather than an enum: FQ revises the pathway (and what each rung is
/// worth) more often than the app ships, and the CDU needs to see the point
/// values as a rubric.
model Qualification {
  id       String              @id @default(cuid())
  code     String              @unique
  label    String
  /// Points for holding this as the staff member's highest qualification.
  points   Int
  stream   QualificationStream @default(OUTFIELD)
  position Int                 @default(0)
  active   Boolean             @default(true)

  staff StaffMember[]
}

enum StaffRole {
  TECHNICAL_DIRECTOR
  HEAD_OF_YOUTH_ACADEMY
  SENIOR_HEAD_COACH
  YOUTH_HEAD_COACH
  JUNIOR_COACH
  GOALKEEPING_COACH
  FEMALE_PROGRAM_LEAD
  PLAYER_DEVELOPMENT_OFFICER
  STRENGTH_AND_CONDITIONING
  MINIROOS_COORDINATOR
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VOLUNTEER
}

enum StaffGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

/// A member of a club's technical staff, as declared for one cycle.
///
/// Attached to the assessment rather than to the club: qualifications, hours
/// and personnel all change year to year, and each year's rating has to stay
/// reproducible from the record that was actually assessed.
model StaffMember {
  id              String         @id @default(cuid())
  assessmentId    String
  assessment      ClubAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  staffRole       StaffRole
  qualificationId String?
  qualification   Qualification? @relation(fields: [qualificationId], references: [id], onDelete: SetNull)
  yearsExperience Int            @default(0)
  employment      EmploymentType @default(VOLUNTEER)
  gender          StaffGender    @default(UNDISCLOSED)
  /// Working with Children Check. Queensland law, and a Non-Negotiable.
  blueCard        Boolean        @default(false)
  blueCardExpiry  DateTime?
  notes           String?
  createdAt       DateTime       @default(now())

  certificates Upload[] @relation("StaffCertificates")

  @@index([assessmentId])
}

/**
 * ------------------- Domains 2-4: Planning, Delivery, Outcomes ------------
 */

enum Domain {
  TECHNICAL
  PLANNING
  DELIVERY
  OUTCOMES
}

enum AssessmentMode {
  /// Scored from documents the club submits. Assessed off-site.
  EVIDENCE
  /// Scored from what an assessor sees at training or on match day.
  OBSERVATION
}

/// One scored criterion — a "line item" in FQ's language. Assessors don't award
/// a score directly: they tick the evidence points they saw, and the count maps
/// to a band.
model Criterion {
  id                  String         @id @default(cuid())
  domain              Domain
  code                String         @unique
  title               String
  description         String?
  /// Evidence-based items and observation-based items run on separate
  /// timetables and are assessed by different people, so the distinction has to
  /// survive into the data rather than living in someone's spreadsheet.
  mode                AssessmentMode @default(EVIDENCE)
  /// The macro-area this item is grouped under within its domain. FQ's report
  /// is structured around these: each carries its own subtotal, its own grade
  /// and its own paragraph of feedback.
  area                String?
  /// Which tiers are assessed on this item.
  tiers               Tier[]
  /// True while the evidence points are this project's wording rather than
  /// Football Queensland's. Surfaced in the app so nobody mistakes a placeholder
  /// for the real rubric.
  evidenceProvisional Boolean        @default(false)
  /// Points multiplier. On Football Queensland's scale this is 4, 6, 8 or 10 —
  /// a line item is worth `maxScore * weight` points towards its domain.
  weight              Int            @default(6)
  position            Int            @default(0)
  active              Boolean        @default(true)

  /// The top of this item's scale. Usually 3; a few go to 4, which is why it
  /// can't be a constant — FQ's D8 awards 4 for 9-10 evidence points met and
  /// carries the heaviest weighting in Delivery, so capping it at 3 would
  /// quietly remove the highest-value mark in the domain.
  maxScore Int @default(3)

  /// Minimum evidence points met to earn each band. Seeded from the number of
  /// sub-criteria but explicit, so the CDU can make one item harder than
  /// another without a code change. fourStarAt is null unless maxScore is 4.
  oneStarAt   Int  @default(1)
  twoStarAt   Int  @default(2)
  threeStarAt Int  @default(3)
  fourStarAt  Int?

  subCriteria SubCriterion[]
  scores      AssessorScore[]
  finalScores FinalScore[]
  assignments CriterionAssignment[]
  reviewItems ReviewItem[]

  @@index([domain])
}

/// A single evidence point under a criterion — the thing an assessor ticks.
model SubCriterion {
  id          String    @id @default(cuid())
  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  text        String
  position    Int       @default(0)

  evidence ScoreEvidence[]

  @@index([criterionId])
}

/// One assessor's score for one criterion on one assessment.
model AssessorScore {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   ClubAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessorId   String
  assessor     User           @relation("AssessorScores", fields: [assessorId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    Criterion      @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  /// Derived from the ticked sub-criteria and stored, so that re-tuning a
  /// criterion's thresholds later doesn't rewrite what an assessor awarded.
  stars     Int      @default(0)
  comment   String?
  updatedAt DateTime @updatedAt

  evidence ScoreEvidence[]

  @@unique([assessmentId, assessorId, criterionId])
  @@index([assessmentId])
  @@index([assessorId])
}

/// A sub-criterion an assessor marked as met. Absence means not met, so only
/// positives are stored.
model ScoreEvidence {
  id             String        @id @default(cuid())
  scoreId        String
  score          AssessorScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  subCriterionId String
  subCriterion   SubCriterion  @relation(fields: [subCriterionId], references: [id], onDelete: Cascade)

  @@unique([scoreId, subCriterionId])
  @@index([subCriterionId])
}

/// The reconciled score for a criterion — what actually counts. Written by the
/// CDU during reconciliation, either accepting a consensus or resolving a split.
model FinalScore {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   ClubAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    Criterion      @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  stars        Int
  /// Required when the CDU departs from what the assessors agreed on.
  rationale    String?
  resolvedById String?
  resolvedBy   User?          @relation("ScoreResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime       @default(now())

  @@unique([assessmentId, criterionId])
  @@index([assessmentId])
}

/**
 * ------------------------------- Non-Negotiables --------------------------
 */

/// One of the nine mandatory eligibility checks.
/// How a Non-Negotiable bears on the result. FQ's nine are not one uniform
/// pass/fail: six are documents that are either there or not, and three set a
/// bar that rises with the shield being sought.
enum NonNegotiableKind {
  /// Pass or fail. Miss one and no shield can be confirmed at all, whatever the
  /// club scored — "no assessment score can be elevated to 'Confirmed' status
  /// while non-negotiable documents are missing or incomplete".
  GATE
  /// A different bar for each shield level. Failing the Gold bar does not make
  /// a club ineligible; it caps them at the level they did meet. FQ phases
  /// these in over four years, so a Bronze club is not failed for lacking the
  /// staffing a Gold club needs.
  SHIELD_THRESHOLD
}

model NonNegotiable {
  id             String            @id @default(cuid())
  code           String            @unique
  title          String
  description    String
  /// What the club has to produce to satisfy it.
  evidenceHint   String?
  kind           NonNegotiableKind @default(GATE)
  /// How FQ collects it, e.g. "Electronic submission & CDA check".
  format         String?
  /// For SHIELD_THRESHOLD checks: what each shield level requires, in prose.
  /// Free text because FQ restates these each year in the Info Pack and the
  /// wording is doing the work, not a machine-readable rule.
  shieldGuidance String?
  position       Int               @default(0)
  active         Boolean           @default(true)

  results NonNegotiableResult[]
}

enum NonNegotiableVerdict {
  /// Not yet verified by the CDU.
  PENDING
  PASS
  FAIL

  /// Shield Threshold standards only. FQ's third verdict: the club has not met
  /// the bar, but keeps its level this season on the understanding that it will
  /// by the next one.
  ///
  /// It is bounded, and the bounds are the whole point — "clubs can only be on
  /// notice for the same line item for one season and no more than one line
  /// item in a year". An on-notice verdict outside those bounds is repeated
  /// non-compliance, and reads as a failure. See checkEligibility.
  ON_NOTICE
}

/// A club's declaration against one Non-Negotiable, and the CDU's verdict.
///
/// The club's self-report and the CDU's verdict are separate fields on purpose:
/// a club claiming compliance is evidence, not a decision, and the gap between
/// the two is exactly what the CDU is checking.
model NonNegotiableResult {
  id               String               @id @default(cuid())
  assessmentId     String
  assessment       ClubAssessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  nonNegotiableId  String
  nonNegotiable    NonNegotiable        @relation(fields: [nonNegotiableId], references: [id], onDelete: Cascade)
  /// The club's own answer. Null until they answer it.
  clubDeclared     Boolean?
  clubNote         String?
  verdict          NonNegotiableVerdict @default(PENDING)
  /// For SHIELD_THRESHOLD checks: the highest shield whose bar this club met.
  /// Null on a GATE check, and null on a threshold check the CDU hasn't looked
  /// at yet. NONE means "looked at, met nobody's bar". This is the effective
  /// level — the one that caps the shield.
  shieldMet        Shield?
  /// What the recorded structure actually computes to, for the checks that can
  /// be computed. Stored alongside rather than instead of `shieldMet` so a
  /// departure is visible as a departure: FQ's own workbook records a level
  /// more generous than its rules on sixteen of thirty-three clubs, and the
  /// portal should make that a decision somebody signed rather than a number
  /// nobody re-derived.
  shieldMetDerived Shield?
  /// Required whenever `shieldMet` departs from `shieldMetDerived`.
  overrideReason   String?
  adminNote        String?
  verifiedById     String?
  verifiedBy       User?                @relation("NonNegotiableVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  updatedAt        DateTime             @updatedAt

  evidence Upload[] @relation("NonNegotiableEvidence")

  @@unique([assessmentId, nonNegotiableId])
  @@index([assessmentId])
}

/**
 * --------------------------------- Outcomes data --------------------------
 */

/// The Club Assessment Unit's paragraph of feedback on one macro-area.
///
/// FQ's report carries one of these per area — "Talent Identification: the club
/// has provided clear documents… there is no overview of the LTAD model" — and
/// it is the part clubs actually act on. A domain-level summary cannot say that,
/// because the useful sentence is always about a particular area.
model AreaNote {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   ClubAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  domain       Domain
  /// Matches Criterion.area. Text rather than a foreign key because an area is a
  /// grouping in the catalogue, not a row, and the note should survive the last
  /// criterion in its area being retired.
  area         String
  comment      String
  updatedAt    DateTime       @updatedAt
  authorId     String?
  author       User?          @relation("AreaNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, domain, area])
  @@index([assessmentId])
}

/// A participation figure the club reports, alongside last year's for
/// comparison. These don't score by themselves — they're the evidence an
/// assessor reads when scoring the Outcomes criteria, which is why they carry
/// no weight of their own.
model ClubMetric {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   ClubAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Stable identifier from the metric catalogue in src/lib/cda/rubric.ts.
  key          String
  value        Float?
  priorValue   Float?
  note         String?

  @@unique([assessmentId, key])
}

/**
 * ------------------------------ Review and appeal ---------------------------
 */

/// Where a club's challenge to its preliminary rating has got to.
enum ReviewStatus {
  /// Submitted by the club; the Unit has 10 working days.
  SUBMITTED
  /// The Unit has responded on every item. The club now has 3 working days to
  /// appeal to the CEO, after which the rating confirms itself.
  RESPONDED
  /// Appealed to the CEO, who has 8 working days.
  APPEALED
  /// The CEO has ruled. FQ: "the above process exhausts all review
  /// opportunities" — there is nowhere further to go from here.
  APPEAL_DECIDED
}

/// One club's request to have specific line items re-examined.
///
/// One per assessment, enforced by the unique key. Football Queensland's process
/// is a single round — request, response, optional appeal, done — and allowing a
/// second request would quietly turn a bounded process into an open one.
model ReviewRequest {
  id           String         @id @default(cuid())
  assessmentId String         @unique
  assessment   ClubAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  status       ReviewStatus   @default(SUBMITTED)

  submittedAt   DateTime @default(now())
  submittedById String?
  submittedBy   User?    @relation("ReviewSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  /// The Unit's covering feedback, alongside the per-item responses.
  respondedAt   DateTime?
  respondedById String?
  respondedBy   User?     @relation("ReviewResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  response      String?

  /// The club's grounds for taking it to the CEO.
  appealedAt DateTime?
  appeal     String?

  /// The CEO's ruling. Free text because it is one person's decision letter,
  /// not a structured outcome — the per-item revisions carry the numbers.
  appealDecidedAt   DateTime?
  appealDecidedById String?
  appealDecidedBy   User?     @relation("AppealDecider", fields: [appealDecidedById], references: [id], onDelete: SetNull)
  appealDecision    String?

  /// The result as it stood when the club asked for the review, so the report
  /// can show what the review actually moved. Recomputing it later would be
  /// impossible once the revised scores are in.
  /// FQ allows one review of the Technical Staff Qualifications score, in both
  /// tiers. It rides on the request rather than in ReviewItem because there is
  /// no Criterion behind it — the Technical score is computed from the club's
  /// staff register, so what a club disputes is how a qualification was read,
  /// and the remedy is a corrected register that recomputes.
  technicalRequested Boolean       @default(false)
  technicalComment   String?
  technicalOutcome   ReviewOutcome @default(PENDING)
  technicalResponse  String?

  percentBefore Float?
  shieldBefore  Shield?

  items ReviewItem[]

  @@index([status])
}

/// What the Unit did with one line item it was asked to look at again.
enum ReviewOutcome {
  /// Not yet answered.
  PENDING
  /// Score changed.
  REVISED
  /// Score stands. FQ's own word — "revise or preserve the score".
  PRESERVED
}

/// One line item a club has asked to have re-examined.
///
/// Football Queensland allows at most 4 Planning, 4 Delivery and 2 Outcomes
/// items. Technical Qualifications is deliberately not reviewable here: it is
/// computed from the staff register rather than scored by an assessor, so the
/// remedy for a wrong Technical score is correcting the register, not appealing
/// a judgement nobody made.
model ReviewItem {
  id          String        @id @default(cuid())
  requestId   String
  request     ReviewRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion     @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  /// The club's case. FQ only admits one ground — that relevant evidence was
  /// missed due to an oversight — so this has to say which evidence and where
  /// it was.
  clubComment String

  outcome     ReviewOutcome @default(PENDING)
  /// The reconciled score before and after. Both stored: the club is entitled
  /// to see the movement, and the before value is gone once the score is
  /// rewritten.
  scoreBefore Int?
  scoreAfter  Int?
  /// The Unit's "detailed feedback to the club regarding their request".
  response    String?

  @@unique([requestId, criterionId])
  @@index([requestId])
}

/**
 * ------------------------- Club Structure Standards -------------------------
 * NN7's level is computed, not judged. Football Queensland maintains it in a
 * workbook today: eleven named functions, each recorded from a fixed
 * vocabulary, against a per-shield bar that ratchets year by year. Recomputing
 * their own 2026 sheet from their own requirements tab disagreed on sixteen of
 * thirty-three clubs, always in the club's favour — which is what a column
 * typed by hand next to a rule nobody re-checks looks like.
 */

/// How one organisational function is recorded.
enum StructureRoleKind {
  /// Filled or not. Goalkeeping, Wellbeing, Sports Science, Analyst, and the
  /// two submitted documents.
  PRESENCE
  /// Filled, and on what terms. The Technical Director only — FQ requires a
  /// full-time TD at every shield, so part-time is a distinct answer from
  /// absent and from present.
  EMPLOYMENT
  /// Filled, and to what qualification. The four Heads whose minimum diploma
  /// rises with the shield.
  QUALIFIED
}

/// What a club recorded against one function.
///
/// One vocabulary across all three kinds rather than three enums, because the
/// answers form a single ladder: absent is worse than present-but-unqualified,
/// which is worse than a C Diploma. Keeping them together is what lets the
/// comparison be a number.
enum RoleStatus {
  /// Nobody in the role.
  ABSENT
  /// In post. The answer for a PRESENCE function.
  PRESENT
  /// EMPLOYMENT only.
  PART_TIME
  FULL_TIME
  /// QUALIFIED: in post, but below the minimum diploma for any shield.
  NOT_MIN_QUAL
  C_DIPLOMA
  /// FQ counts enrolment towards the B Diploma as holding it — "hold or are
  /// enrolled in a min. B Diploma".
  ENROLLED_B
  B_DIPLOMA_PLUS
}

/// One of Football Queensland's organisational functions.
model StructureRole {
  id       String            @id @default(cuid())
  code     String            @unique
  label    String
  kind     StructureRoleKind @default(PRESENCE)
  /// False for the two submitted documents, which are required at every shield
  /// but are not one of the eleven functions the coverage count is drawn from.
  counts   Boolean           @default(true)
  position Int               @default(0)
  active   Boolean           @default(true)

  entries      StructureEntry[]
  requirements StructureRoleRequirement[]
}

/// The bar for one shield in one cycle.
///
/// Per cycle because FQ phases it in: 8 of 11 functions for Gold in 2026, 9 in
/// 2027, all 11 in 2028. A new year is a data change here, not a code change.
model StructureStandard {
  id                String @id @default(cuid())
  cycleId           String
  cycle             Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  shield            Shield
  /// How many of the counting functions must be filled.
  functionsRequired Int    @default(0)

  roles StructureRoleRequirement[]

  @@unique([cycleId, shield])
}

/// What one shield demands of one function, over and above being counted.
model StructureRoleRequirement {
  id              String            @id @default(cuid())
  standardId      String
  standard        StructureStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  roleId          String
  role            StructureRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// Mandatory at this shield regardless of the coverage count.
  required        Boolean           @default(false)
  /// 0 = no qualification requirement. 1 = C Diploma. 2 = B Diploma or
  /// enrolled. Stored as a level rather than a RoleStatus because the test is
  /// "at least", and two different statuses satisfy level 2.
  minQualLevel    Int               @default(0)
  /// EMPLOYMENT roles only: part-time doesn't satisfy this shield.
  requireFullTime Boolean           @default(false)

  @@unique([standardId, roleId])
}

/// What one club recorded against one function.
model StructureEntry {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   ClubAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  roleId       String
  role         StructureRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status       RoleStatus     @default(ABSENT)
  /// Who holds it. Not scored — it is what makes the Unit's check possible.
  holderName   String?
  note         String?
  updatedAt    DateTime       @updatedAt

  @@unique([assessmentId, roleId])
  @@index([assessmentId])
}
