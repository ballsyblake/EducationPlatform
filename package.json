  "type": "module",
  "description": "A Canvas-style learning platform for football coaching staffs.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
