# Local development environment. Copy from .env.example and adjust.
# Local SQLite by default. For a hosted Turso database use the libsql:// URL
# from `turso db show <name> --url` and set TURSO_AUTH_TOKEN alongside it.
DATABASE_URL="file:./prisma/dev.db"
# TURSO_AUTH_TOKEN=""
APP_URL="http://localhost:3000"

# Leave SMTP_HOST unset to run in dev mail mode: magic links are printed to the
# server console and appended to .mail-outbox.log instead of being emailed.
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASSWORD=""
# MAIL_FROM="Coach Education <coaching@footballqueensland.com.au>"

# The coach portal is parked: coaches cannot sign in, and their records, pages
# and marks are all untouched. "on" brings it back; anything else leaves it off.
# COACH_PORTAL="on"

# Comma-separated emails bootstrapped as ADMIN by `npm run db:seed`.
ADMIN_EMAILS="head.coach@example.com"

# Uploads are stored as database rows, so keep this modest when using Turso.
# MAX_UPLOAD_MB="10"

# Football Queensland's master logo, used by the app's header and by the Word
# export. The artwork is committed at public/brand/; unset, the app sets its own
# name in brand type instead, which is not the mark. Read at build time.
NEXT_PUBLIC_FQ_LOGO="/brand/fq-logo-horizontal.png"
# The mono white version, for the Deep Maroon header. Not supplied yet, so the
# header sets the product name in brand type instead — the colour mark must not
# stand in for it on maroon. Drop the file in public/brand/ and point here.
# NEXT_PUBLIC_FQ_LOGO_LIGHT="/brand/fq-logo-horizontal-white.svg"

# Sign-in tuning (all optional; defaults shown).
# SESSION_IDLE_DAYS="60"          # sessions slide forward on use
# INVITE_LINK_TTL_DAYS="7"        # links an admin hands over by hand
# EMAIL_LINK_TTL_MINUTES="20"     # links a coach requests by email
